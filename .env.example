# Copy to .env. No secrets: EasySpotDL uses no credentials.
ENV=dev
# Dev environment: empty skips the check; a file:// URL points to a local test Release Channel,
# a JSON file like {"tag_name": "v0.2.0", "html_url": "https://github.com/nuclear-hazes/EasySpotDL/releases/tag/v0.2.0"}
DEV_RELEASE_CHANNEL_URL=
# Prod environment
PROD_RELEASE_CHANNEL_URL=https://api.github.com/repos/nuclear-hazes/EasySpotDL/releases/latest
